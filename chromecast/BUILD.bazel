load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools:mbedtls.bzl", "mbedtls_cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "mbedtls_config",
    hdrs = ["mbedtls_config.h"],
    defines = ['MBEDTLS_CONFIG_FILE=\\"chromecast/mbedtls_config.h\\"'],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "mbedtls_test_config",
    hdrs = [
        "mbedtls_config.h",
        "mbedtls_test_config.h",
    ],
    defines = ['MBEDTLS_CONFIG_FILE=\\"chromecast/mbedtls_test_config.h\\"'],
    visibility = ["//visibility:public"],
)

# The Chromecast setup API: JSON, HTTPS without certificate checks, RSA
# password encryption, and LAN discovery.
cc_library(
    name = "protocol",
    srcs = [
        "discovery.cc",
        "http.cc",
        "json.cc",
        "protocol.cc",
    ],
    hdrs = [
        "discovery.h",
        "http.h",
        "json.h",
        "protocol.h",
    ],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//common:support",
        "@mbedtls",
    ],
)

# The background flows. Binaries also link a Platform implementation.
cc_library(
    name = "session",
    srcs = [
        "session.cc",
        "storage.cc",
    ],
    hdrs = [
        "platform.h",
        "session.h",
        "storage.h",
    ],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":protocol",
        "//common:support",
    ],
)

cc_library(
    name = "android_platform",
    srcs = ["android_platform.cc"],
    hdrs = ["android_platform.h"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":session",
        "//common:support",
    ],
)

cc_library(
    name = "fakes",
    testonly = True,
    srcs = ["fakes.cc"],
    hdrs = ["fakes.h"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":protocol",
        ":session",
        "//common:support",
        "@mbedtls",
    ],
)

cc_library(
    name = "app",
    srcs = [
        "app.cc",
        "view.cc",
    ],
    hdrs = [
        "app.h",
        "view.h",
    ],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":session",
        "//common:support",
        "//common/gpu",
    ],
)

cc_library(
    name = "chromecast_lib",
    srcs = ["main.cc"],
    linkopts = [
        "-ljnigraphics",
        "-lnativewindow",
    ],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":android_platform",
        ":app",
        "//common:support",
    ],
    # NativeActivity looks up ANativeActivity_onCreate dynamically.
    alwayslink = True,
)

android_binary(
    name = "chromecast",
    srcs = ["ChromecastActivity.java"],
    custom_package = "dev.demo.chromecast",
    generate_art_profile = False,
    manifest = "main.xml",
    resource_files = ["res/values/styles.xml"],
    visibility = ["//visibility:public"],
    deps = [":chromecast_lib"],
)

# Read-only check of a real Chromecast: bazel run //chromecast:probe -- <IPv4>
cc_binary(
    name = "probe",
    srcs = ["probe.cc"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [":protocol"],
)

mbedtls_cc_test(
    name = "protocol_test",
    size = "small",
    srcs = ["protocol_test.cc"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":protocol",
        "@mbedtls",
    ],
)

mbedtls_cc_test(
    name = "session_test",
    size = "medium",
    srcs = ["session_test.cc"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":fakes",
        ":protocol",
        ":session",
    ],
)

mbedtls_cc_test(
    name = "app_test",
    size = "medium",
    srcs = ["app_test.cc"],
    copts = select({
        "//tools:vulkan_validation": ["-DNATIVE_BUTTONS_VULKAN_VALIDATION"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":app",
        ":fakes",
        "//common:support",
        "//common/gpu",
    ],
)

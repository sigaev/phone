load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools:android.bzl", "ANDROID_COPTS", "ANDROID_LINKOPTS")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "game",
    srcs = [
        "game.cc",
        "generator.cc",
        "puzzle.cc",
        "storage.cc",
    ],
    hdrs = [
        "game.h",
        "generator.h",
        "puzzle.h",
        "storage.h",
    ],
    copts = ANDROID_COPTS,
    target_compatible_with = ["@platforms//os:android"],
    deps = ["//common:support"],
)

cc_library(
    name = "app",
    srcs = [
        "app.cc",
        "view.cc",
    ],
    hdrs = [
        "app.h",
        "view.h",
    ],
    copts = ANDROID_COPTS,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":game",
        "//common:support",
        "//common/gpu",
    ],
)

cc_library(
    name = "sudoku_lib",
    srcs = ["main.cc"],
    copts = ANDROID_COPTS,
    linkopts = ANDROID_LINKOPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":app",
        "//common:support",
    ],
    # NativeActivity looks up ANativeActivity_onCreate dynamically.
    alwayslink = True,
)

android_binary(
    name = "sudoku",
    custom_package = "dev.demo.sudoku",
    generate_art_profile = False,
    manifest = "main.xml",
    visibility = ["//visibility:public"],
    deps = [":sudoku_lib"],
)

cc_test(
    name = "puzzle_test",
    size = "medium",
    srcs = ["puzzle_test.cc"],
    copts = ANDROID_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":game",
        "//common:support",
    ],
)

cc_test(
    name = "game_test",
    size = "small",
    srcs = ["game_test.cc"],
    copts = ANDROID_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":game",
        "//common:support",
    ],
)

cc_test(
    name = "app_test",
    size = "medium",
    srcs = ["app_test.cc"],
    copts = ANDROID_COPTS + select({
        "//tools:vulkan_validation": ["-DNATIVE_BUTTONS_VULKAN_VALIDATION"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":app",
        ":game",
        "//common:support",
        "//common/gpu",
    ],
)

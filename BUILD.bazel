package(default_visibility = ["//visibility:public"])

# rules_android uses the platform target's name as the APK's ABI directory.
# Android's only 64-bit ARM ABI is arm64-v8a, which ARMv9-A CPUs also run;
# .bazelrc selects the ARMv9-A instruction set.
platform(
    name = "arm64-v8a",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

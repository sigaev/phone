load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools:android.bzl", "ANDROID_COPTS", "ANDROID_LINKOPTS")
load("//tools:spirv.bzl", "spirv_shader")

[spirv_shader(
    name = name.replace(".", "_"),
    src = "shaders/" + name,
) for name in [
    "mesh.vert",
    "scene.frag",
    "sky.frag",
]]

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "scene",
    srcs = [
        "controls.cc",
        "scene.cc",
        "shaders.cc",
        ":mesh_vert",
        ":scene_frag",
        ":sky_frag",
    ],
    hdrs = [
        "controls.h",
        "scene.h",
    ],
    copts = ANDROID_COPTS,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//common:support",
        "//common/gpu",
    ],
)

cc_library(
    name = "runtime",
    srcs = [
        "runtime.cc",
        "state.cc",
        "storage.cc",
    ],
    hdrs = [
        "runtime.h",
        "state.h",
        "storage.h",
    ],
    copts = ANDROID_COPTS,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_library(
    name = "gestures",
    srcs = ["gestures.cc"],
    hdrs = ["gestures.h"],
    copts = ANDROID_COPTS,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":runtime",
        "//common:support",
    ],
)

cc_library(
    name = "native_buttons_lib",
    srcs = ["main.cc"],
    copts = ANDROID_COPTS,
    linkopts = ANDROID_LINKOPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":gestures",
        ":runtime",
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
    # NativeActivity looks up ANativeActivity_onCreate dynamically.
    alwayslink = True,
)

android_binary(
    name = "native_buttons",
    custom_package = "dev.demo.nativebuttons",
    generate_art_profile = False,
    manifest = "main.xml",
    visibility = ["//visibility:public"],
    deps = [":native_buttons_lib"],
)

cc_binary(
    name = "gpu_probe",
    srcs = ["gpu_probe.cc"],
    copts = ANDROID_COPTS + select({
        "//tools:vulkan_validation": ["-DNATIVE_BUTTONS_VULKAN_VALIDATION"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_test(
    name = "scene_test",
    size = "small",
    srcs = ["scene_test.cc"],
    copts = ANDROID_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_test(
    name = "application_test",
    size = "medium",
    srcs = ["application_test.cc"],
    copts = ANDROID_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":runtime",
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_test(
    name = "gestures_test",
    size = "small",
    srcs = ["gestures_test.cc"],
    copts = ANDROID_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":gestures",
        ":runtime",
        "//common:support",
    ],
)

cc_test(
    name = "state_test",
    size = "small",
    srcs = ["state_test.cc"],
    copts = ANDROID_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [":runtime"],
)

cc_test(
    name = "runtime_fault_test",
    size = "medium",
    srcs = ["runtime_fault_test.cc"],
    copts = ANDROID_COPTS,
    linkopts = ["-Wl,--wrap=AChoreographer_postFrameCallback"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":gestures",
        ":runtime",
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_test(
    name = "depth_fallback_test",
    size = "medium",
    srcs = ["gpu_probe.cc"],
    args = ["--exercise"],
    copts = ANDROID_COPTS + ["-DNATIVE_BUTTONS_TEST_DEPTH_FALLBACK"] + select({
        "//tools:vulkan_validation": ["-DNATIVE_BUTTONS_VULKAN_VALIDATION"],
        "//conditions:default": [],
    }),
    linkopts = ["-Wl,--wrap=vkGetPhysicalDeviceImageFormatProperties"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_test(
    name = "renderer_test",
    size = "medium",
    srcs = ["gpu_probe.cc"],
    args = ["--exercise"],
    copts = ANDROID_COPTS + select({
        "//tools:vulkan_validation": ["-DNATIVE_BUTTONS_VULKAN_VALIDATION"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

cc_test(
    name = "presentation_test",
    size = "medium",
    srcs = ["presentation_test.cc"],
    copts = ANDROID_COPTS + select({
        "//tools:vulkan_validation": ["-DNATIVE_BUTTONS_VULKAN_VALIDATION"],
        "//conditions:default": [],
    }),
    linkopts = [
        "-Wl,--wrap=ANativeWindow_getWidth",
        "-Wl,--wrap=ANativeWindow_getHeight",
        "-Wl,--wrap=vkEnumerateInstanceExtensionProperties",
        "-Wl,--wrap=vkCreateAndroidSurfaceKHR",
        "-Wl,--wrap=vkDestroySurfaceKHR",
        "-Wl,--wrap=vkGetPhysicalDeviceSurfaceSupportKHR",
        "-Wl,--wrap=vkGetPhysicalDeviceSurfaceFormatsKHR",
        "-Wl,--wrap=vkGetPhysicalDeviceSurfaceCapabilitiesKHR",
        "-Wl,--wrap=vkCreateSwapchainKHR",
        "-Wl,--wrap=vkDestroySwapchainKHR",
        "-Wl,--wrap=vkGetSwapchainImagesKHR",
        "-Wl,--wrap=vkAcquireNextImageKHR",
        "-Wl,--wrap=vkQueuePresentKHR",
        "-Wl,--wrap=vkWaitForFences",
        "-Wl,--wrap=vkDestroySemaphore",
        "-Wl,--wrap=vkDestroyFence",
        "-Wl,--wrap=vkDeviceWaitIdle",
        "-Wl,--wrap=vkCreateRenderPass",
    ],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        ":scene",
        "//common:support",
        "//common/gpu",
    ],
)

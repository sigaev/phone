#version 460
// Adds split-K partial sums: output i is the sum of partial s * kCount + i over
// the kSplit slices, in slice order, so every run gives identical results.
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint kCount = 1;  // elements of C
layout(constant_id = 1) const uint kSplit = 2;

#if defined(INT32)
#define PARTIAL int
#define OUT int
#elif defined(FP16_OUTPUT)
#define PARTIAL float
#define OUT float16_t
#else
#define PARTIAL float
#define OUT float
#endif

layout(std430, binding = 0) readonly buffer Partial { PARTIAL partial[]; };

layout(std430, binding = 1) writeonly buffer C { OUT c[]; };

void main() {
  uint i =
      (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256 + gl_LocalInvocationID.x;
  if (i >= kCount) return;
  PARTIAL sum = partial[i];
  [[unroll]] for (uint s = 1; s < kSplit; ++s)
    sum += partial[s * kCount + i];
  c[i] = OUT(sum);
}

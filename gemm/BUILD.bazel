load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools:spirv.bzl", "glslang_shader")
load(":kernels.bzl", "gemm_kernels")

package(default_visibility = ["//visibility:private"])

# Microbenchmarks of the GPU's arithmetic, loads, and memory, used by `gemm
# peak`, `gemm loads`, `gemm layouts`, `gemm bandwidth`, and `gemm dispatch`.
# Loops have specialized trip counts, as the GEMM kernels' do, except in
# peak_fp32_runtime, which shows what a runtime trip count costs.

glslang_shader(
    name = "peak_fp32_runtime",
    src = "shaders/peak.comp",
    defines = [
        "FP32",
        "T=float",
    ],
)

[glslang_shader(
    name = "peak_" + name,
    src = "shaders/peak.comp",
    defines = defines + ["CONSTANT_ITERATIONS"],
) for name, defines in {
    "fp32": [
        "FP32",
        "T=float",
    ],
    "fp16x2": [
        "FP16",
        "T=f16vec2",
    ],
    "int8": ["INT8"],
}.items()]

# fp16 FMAs alongside cross-lane moves, one move per FMA.
[glslang_shader(
    name = "peak_mix_fp16x2_" + name,
    src = "shaders/peak.comp",
    defines = [
        "FP16",
        "T=f16vec2",
        "MIX",
        "U=uint",
        "MIX_STEP(w)=" + step,
        "MIX_VALUE(w)=unpackFloat2x16(w)",
        "CONSTANT_ITERATIONS",
    ],
) for name, step in {
    "shuffle_xor": "subgroupShuffleXor(w,1u)",
    "broadcast": "subgroupBroadcast(w,3u)",
    "quad_broadcast": "subgroupQuadBroadcast(w,1u)",
}.items()]

[glslang_shader(
    name = "peak_coop_{}_{}".format(
        precision.lower(),
        chains,
    ),
    src = "shaders/peak_coop.comp",
    defines = [
        precision,
        "CHAINS={}".format(chains),
    ],
) for precision, chains in [
    ("FP32_SMALL", 16),
    ("FP32_SMALL", 24),
    ("FP32_SMALL", 32),
    ("FP16_SMALL", 16),
    ("FP16_SMALL", 24),
    ("INT8", 12),
    ("INT8", 14),
]]

# The order of dependent multiplies: each accumulator's steps back to back, or
# the accumulators interleaved.
[glslang_shader(
    name = "peak_coop_build_" + order.lower(),
    src = "shaders/peak_coop.comp",
    defines = [
        "INT8",
        "BUILD_" + order,
        "CHAINS=8",
    ],
) for order in [
    "CHAINED",
    "INTERLEAVED",
]]

[glslang_shader(
    name = "load_" + mode.lower(),
    src = "shaders/load.comp",
    defines = [
        mode,
        "CONSTANT_ITERATIONS",
    ],
) for mode in [
    "GLOBAL_VEC4",
    "GLOBAL_VEC4_ROWS",
    "GLOBAL_VEC2",
    "GLOBAL_VEC2_HALF_LINES",
    "GLOBAL_SCALAR",
    "GLOBAL_SCALAR_LINE",
    "GLOBAL_UNIFORM",
    "SHARED_VEC4",
    "TEXEL_VEC4",
    "IMAGE_VEC4",
    "IMAGE_VEC4_ROWS",
    "IMAGE_VEC2",
    "IMAGE_SCALAR",
    "COOP_GLOBAL",
    "COOP_SHARED",
]]

glslang_shader(
    name = "empty",
    src = "shaders/empty.comp",
)

[glslang_shader(
    name = "layout_{}_{}_{}x{}".format(
        name,
        use.lower(),
        rows,
        cols,
    ),
    src = "shaders/layout.comp",
    defines = [
        "TYPE=" + element,
        "USE=gl_MatrixUse" + use,
        "ROWS={}".format(rows),
        "COLS={}".format(cols),
    ],
) for name, element, use, rows, cols in [
    ("fp32", "float", "A", 16, 16),
    ("fp32", "float", "B", 16, 16),
    ("fp32", "float", "Accumulator", 16, 16),
    ("fp32", "float", "A", 4, 4),
    ("fp32", "float", "B", 4, 4),
    ("fp32", "float", "Accumulator", 4, 4),
    ("fp16", "float16_t", "A", 16, 32),
    ("fp16", "float16_t", "B", 32, 32),
    ("fp32", "float", "Accumulator", 16, 32),
    ("fp16", "float16_t", "A", 4, 8),
    ("fp16", "float16_t", "B", 8, 8),
    ("fp32", "float", "Accumulator", 4, 8),
    ("int8", "int8_t", "A", 4, 16),
    ("int8", "int8_t", "B", 16, 16),
    ("int32", "int32_t", "Accumulator", 4, 16),
]]

[glslang_shader(
    name = "bandwidth_{}_{}".format(
        mode.lower(),
        unroll,
    ),
    src = "shaders/bandwidth.comp",
    defines = [
        mode,
        "UNROLL={}".format(unroll),
    ],
) for mode, unroll in [
    ("READ", 1),
    ("READ", 4),
    ("READ", 16),
    ("COPY", 4),
    ("WRITE", 4),
]]

# Adds split-K partial sums into C.
[glslang_shader(
    name = "reduce_" + name,
    src = "shaders/reduce.comp",
    defines = defines,
) for name, defines in {
    "fp16": ["FP16_OUTPUT"],
    "fp32": [],
    "int32": ["INT32"],
}.items()]

# The GEMM kernels, each with the variants the benchmark measures. block_m and
# block_n are a workgroup's tile of C; see each shader for its method.
gemm_kernels(
    name = "variants",
    kernels = [{
        "name": "gemm_int8_{}x{}_{}x{}_atex{}".format(wm, wn, sgm, sgn, textured),
        "src": "shaders/gemm_int8.comp",
        "hdrs": ["shaders/raster.glsl"],
        "defines": [
            "A_TEXTURE={}".format(textured),
            "WM={}".format(wm),
            "WN={}".format(wn),
            "SG_M={}".format(sgm),
            "SG_N={}".format(sgn),
        ],
        "variants": [{
            "label": "mma {}x{} {}x{}{}".format(
                wm,
                wn,
                sgm,
                sgn,
                ", {} A tile textured".format(textured) if textured else "",
            ),
            "precision": "kInt8",
            "block_m": sgm * wm * 4,
            "block_n": sgn * wn * 16,
            "k_multiple": 32,
            "b_image": True,
            "a_image": textured > 0,
            "raster": True,
            "split": True,
            "subgroups": sgm * sgn,
            "texel_bytes": 8,
        }],
    } for wm, wn, sgm, sgn, textured in [
        (6, 1, 2, 2, 0),
        (4, 1, 2, 2, 0),
        (2, 1, 2, 2, 0),
        (6, 1, 2, 2, 1),
        (6, 1, 2, 8, 1),
        (6, 1, 2, 16, 1),
        (4, 1, 2, 8, 1),
    ]] + [{
        "name": "gemm_mma4_{}_{}_{}x{}_{}x{}_atex{}".format(
            precision.lower(),
            vector,
            wm,
            wn,
            sgm,
            sgn,
            textured,
        ),
        "src": "shaders/gemm_mma4.comp",
        "hdrs": ["shaders/raster.glsl"],
        "defines": [
            precision,
            "A_TEXTURE={}".format(textured),
            "VECTOR={}".format(vector),
            "WM={}".format(wm),
            "WN={}".format(wn),
            "SG_M={}".format(sgm),
            "SG_N={}".format(sgn),
        ],
        # fp16 inputs accumulate in fp32, which also serves fp16 outputs.
        "variants": [{
            "label": "mma4 {}x{} {}x{} {}B{}{}".format(
                wm,
                wn,
                sgm,
                sgn,
                vector,
                suffix,
                ", {} A tile{} textured".format(
                    textured,
                    "s" if textured > 1 else "",
                ) if textured else "",
            ),
            "precision": category,
            "block_m": sgm * wm * 4,
            "block_n": sgn * wn * 4,
            "k_multiple": 4 * vector // (4 if precision == "FP32" else 2),
            "a_image": textured > 0,
            "b_image": True,
            "raster": True,
            "split": True,
            "subgroups": sgm * sgn,
            "texel_bytes": vector,
        } for category, suffix in (
            [("kFp32", "")] if precision == "FP32" else [("kFp16Fp32", "")] + (
                # The two fastest also serve fp16 outputs, accumulating in fp32.
                [("kFp16", " fp32acc")] if vector == 16 and wm == 4 and wn in (3, 4) and not textured else []
            )
        )],
    } for precision, vector, wm, wn, sgm, sgn, textured in [
        ("FP32", 16, 4, 5, 2, 2, 0),
        ("FP32", 16, 4, 5, 2, 4, 0),
        ("FP32", 16, 4, 5, 4, 4, 0),
        ("FP32", 16, 6, 4, 2, 2, 0),
        ("FP32", 16, 4, 3, 2, 2, 0),
        ("FP32", 8, 2, 6, 2, 2, 0),
        ("FP32", 16, 4, 5, 2, 2, 1),
        ("FP32", 16, 4, 5, 2, 2, 2),
        ("FP32", 16, 4, 5, 2, 2, 4),
        ("FP32", 16, 4, 3, 2, 2, 1),
        ("FP32", 16, 4, 3, 2, 2, 2),
        ("FP32", 16, 4, 3, 2, 2, 4),
        ("FP16", 16, 4, 4, 2, 2, 0),
        ("FP16", 16, 4, 3, 2, 2, 0),
        ("FP16", 8, 2, 6, 2, 2, 0),
    ]] + [{
        "name": "gemm_mma8_{}x{}_{}x{}".format(wm, wn, sgm, sgn),
        "src": "shaders/gemm_mma8.comp",
        "hdrs": ["shaders/raster.glsl"],
        "defines": [
            "WM={}".format(wm),
            "WN={}".format(wn),
            "SG_M={}".format(sgm),
            "SG_N={}".format(sgn),
        ],
        # fp32 accumulation also serves fp16 outputs, as for gemm_mma4.
        "variants": [{
            "label": "mma8 {}x{} {}x{}{}".format(wm, wn, sgm, sgn, suffix),
            "precision": category,
            "block_m": sgm * wm * 4,
            "block_n": sgn * wn * 8,
            "k_multiple": 32,
            "b_image": True,
            "raster": True,
            "split": True,
            "subgroups": sgm * sgn,
            "texel_bytes": 16,
        } for category, suffix in [
            ("kFp16Fp32", ""),
            ("kFp16", " fp32acc"),
        ]],
    } for wm, wn, sgm, sgn in [
        (8, 1, 2, 2),
        (4, 2, 2, 2),
        (6, 1, 2, 4),
        (4, 1, 2, 2),
    ]] + [{
        "name": "gemm_hfma_{}x{}_{}x{}".format(tm, tn, sgm, sgn),
        "src": "shaders/gemm_hfma.comp",
        "hdrs": ["shaders/raster.glsl"],
        "defines": [
            "TM={}".format(tm),
            "TN={}".format(tn),
            "SG_M={}".format(sgm),
            "SG_N={}".format(sgn),
        ],
        "variants": [{
            "label": "hfma {}x{} {}x{}".format(tm, tn, sgm, sgn),
            "precision": "kFp16",
            "block_m": sgm * tm * 4,
            "block_n": sgn * tn * 4,
            "k_multiple": 8,
            "b_image": True,
            "raster": True,
            "texel_bytes": 16,
        }],
    } for tm, tn, sgm, sgn in [
        (5, 5, 2, 2),
        (6, 5, 2, 2),
    ]] + [{
        "name": "gemv_{}_{}x{}".format(
            precision.lower(),
            rows,
            max_m,
        ),
        "src": "shaders/gemv.comp",
        "defines": [
            precision,
            "ROWS={}".format(rows),
            "MAX_M={}".format(max_m),
            "ELEMENT_BYTES={}".format(size),
        ],
        "variants": [{
            "label": "gemv {} rows, M<={}".format(rows, max_m),
            "precision": category,
            "block_m": max_m,
            "block_n": 4 * rows,
            "k_multiple": 16 // size,
            "max_m": max_m,
        } for category in {
            "FP16": [
                "kFp16Fp32",
                "kFp16",
            ],
            "FP32": ["kFp32"],
            "INT8": ["kInt8"],
        }[precision]],
    } for precision, rows, max_m, size in [
        ("FP32", 4, 1, 4),
        ("FP32", 4, 4, 4),
        ("FP16", 4, 1, 2),
        ("FP16", 8, 1, 2),
        ("FP16", 4, 4, 2),
        ("INT8", 4, 1, 1),
        ("INT8", 8, 1, 1),
        ("INT8", 4, 4, 1),
    ]],
)

# Each tiled kernel with work removed, timed by `gemm ablate` to show what
# limits it; see ABLATE in gemm_mma4.comp. These compute wrong results.
gemm_kernels(
    name = "ablations",
    kernels = [{
        "name": "ablate_{}_{}".format(kernel, ablate),
        "src": "shaders/{}.comp".format(source),
        "hdrs": ["shaders/raster.glsl"],
        "defines": defines + ["ABLATE={}".format(ablate)],
        "variants": [dict(
            variant,
            b_image = True,
            label = variant["label"] + suffix,
            raster = True,
        )],
    } for kernel, source, defines, variant in [
        (
            "mma4_fp32",
            "gemm_mma4",
            [
                "FP32",
                "VECTOR=16",
                "WM=4",
                "WN=5",
                "SG_M=2",
                "SG_N=2",
            ],
            {
                "label": "mma4 4x5 2x2 16B",
                "precision": "kFp32",
                "block_m": 32,
                "block_n": 40,
                "k_multiple": 16,
            },
        ),
        (
            "mma4_fp16",
            "gemm_mma4",
            [
                "FP16",
                "VECTOR=16",
                "WM=4",
                "WN=4",
                "SG_M=2",
                "SG_N=2",
            ],
            {
                "label": "mma4 4x4 2x2 16B",
                "precision": "kFp16Fp32",
                "block_m": 32,
                "block_n": 32,
                "k_multiple": 32,
            },
        ),
        (
            "mma8",
            "gemm_mma8",
            [
                "WM=8",
                "WN=1",
                "SG_M=2",
                "SG_N=2",
            ],
            {
                "label": "mma8 8x1 2x2",
                "precision": "kFp16Fp32",
                "block_m": 64,
                "block_n": 16,
                "k_multiple": 32,
            },
        ),
        (
            "int8_2",
            "gemm_int8",
            [
                "WM=6",
                "WN=1",
                "SG_M=2",
                "SG_N=2",
            ],
            {
                "label": "mma 6x1 2x2",
                "precision": "kInt8",
                "block_m": 48,
                "block_n": 32,
                "k_multiple": 32,
                "texel_bytes": 8,
            },
        ),
        (
            "hfma",
            "gemm_hfma",
            [
                "TM=5",
                "TN=5",
                "SG_M=2",
                "SG_N=2",
            ],
            {
                "label": "hfma 5x5 2x2",
                "precision": "kFp16",
                "block_m": 40,
                "block_n": 40,
                "k_multiple": 8,
            },
        ),
    ] for ablate, suffix in {
        0: "",
        1: ", no A loads",
        2: ", no B loads",
        3: ", no loads",
        4: ", loads only",
        8: ", loads from L1",
    }.items()],
)

cc_library(
    name = "runtime",
    srcs = [
        "bench.cc",
        "check.cc",
        "device.cc",
        "measure.cc",
        "problem.cc",
        "sensors.cc",
        ":ablations",
        ":reduce_fp16",
        ":reduce_fp32",
        ":reduce_int32",
        ":variants",
    ],
    hdrs = [
        "bench.h",
        "check.h",
        "device.h",
        "measure.h",
        "problem.h",
        "sensors.h",
    ],
    linkopts = ["-lvulkan"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//common:support",
        "@vulkan_headers",
    ],
)

cc_binary(
    name = "gemm",
    srcs = ["main.cc"] + [":" + name for name in [
        "empty",
        "bandwidth_copy_4",
        "bandwidth_read_1",
        "bandwidth_read_16",
        "bandwidth_read_4",
        "bandwidth_write_4",
        "peak_fp32_runtime",
    ] + ["load_" + mode for mode in [
        "coop_global",
        "coop_shared",
        "global_scalar",
        "global_scalar_line",
        "global_uniform",
        "global_vec2",
        "global_vec2_half_lines",
        "global_vec4",
        "global_vec4_rows",
        "image_scalar",
        "image_vec2",
        "image_vec4",
        "image_vec4_rows",
        "shared_vec4",
        "texel_vec4",
    ]] + ["layout_" + layout for layout in [
        "fp16_a_16x32",
        "fp16_a_4x8",
        "fp16_b_32x32",
        "fp16_b_8x8",
        "fp32_a_16x16",
        "fp32_a_4x4",
        "fp32_accumulator_16x16",
        "fp32_accumulator_16x32",
        "fp32_accumulator_4x4",
        "fp32_accumulator_4x8",
        "fp32_b_16x16",
        "fp32_b_4x4",
        "int32_accumulator_4x16",
        "int8_a_4x16",
        "int8_b_16x16",
    ]] + ["peak_" + peak for peak in [
        "coop_build_chained",
        "coop_build_interleaved",
        "coop_fp16_small_16",
        "coop_fp16_small_24",
        "coop_fp32_small_16",
        "coop_fp32_small_24",
        "coop_fp32_small_32",
        "coop_int8_12",
        "coop_int8_14",
        "fp16x2",
        "fp32",
        "int8",
        "mix_fp16x2_broadcast",
        "mix_fp16x2_quad_broadcast",
        "mix_fp16x2_shuffle_xor",
    ]]],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [":runtime"],
)

cc_test(
    name = "gemm_test",
    size = "large",
    srcs = ["gemm_test.cc"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android"],
    deps = [":runtime"],
)
